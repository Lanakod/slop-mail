{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slop Mail",
  "version": "0.3.0",
  "identifier": "org.slopmail.desktop",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Slop Mail",
        "width": 1240,
        "height": 800,
        "minWidth": 540,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-src 'self' about:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNUI3Q0FCNjE4N0NCQjAKUldTd3k0ZGhxM3hidzM5MXVFbG1lWUJIOWhJbDd1M1FzQm5jd255RHlvMW1QL1ZvRyt3UXBoU3oK",
      "endpoints": [
        "https://github.com/Lanakod/slop-mail/releases/latest/download/latest.json"
      ]
    }
  }
}
